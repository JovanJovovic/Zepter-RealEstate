# Dependencies
node_modules/

# Build output
dist/

# Environment variables
.env
.env.*
!.env.example

# Uploads / user files
# Runtime files in the uploads root remain ignored. Only public media folders
# that are intentionally deployed with the project are allowlisted.
uploads/*
!uploads/blog/
!uploads/blog/**
!uploads/news/
!uploads/news/**
!uploads/property_images/
!uploads/property_images/**
!uploads/property_pdfs/
!uploads/property_pdfs/**

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime / cache
.cache/
.tmp/
temp/
coverage/

# TypeScript
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# Editor folders
.vscode/*
!.vscode/extensions.json
.idea/

# Misc
*.local
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
